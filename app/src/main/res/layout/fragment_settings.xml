<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Section: Contacts / Shortcuts -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_contacts"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/ll_contacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btn_add_contact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_contact"
            android:layout_marginTop="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginVertical="16dp" />

        <!-- Section: Weather -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_weather"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_weather_location"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/weather_location_hint"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:background="@color/input_background"
                android:padding="12dp"
                android:textSize="16sp"
                android:inputType="text"
                android:singleLine="true" />

            <Button
                android:id="@+id/btn_save_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/save" />
        </LinearLayout>

        <RadioGroup
            android:id="@+id/rg_temp_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rb_celsius"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/celsius"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/rb_fahrenheit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fahrenheit"
                android:textColor="@color/text_primary"
                android:layout_marginStart="16dp" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginVertical="16dp" />

        <!-- Section: Messages -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_messages"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <Switch
            android:id="@+id/switch_read_aloud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/read_messages_aloud"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginVertical="16dp" />

        <!-- Section: Display -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_display"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/idle_timeout_label"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/et_idle_timeout"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="20"
                android:textColor="@color/text_primary"
                android:background="@color/input_background"
                android:padding="8dp"
                android:textSize="16sp"
                android:inputType="number"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/seconds"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginStart="4dp" />

            <Button
                android:id="@+id/btn_save_idle_timeout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/save" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginVertical="16dp" />

        <!-- Section: Security / Kiosk -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_security"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btn_notification_access"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/grant_notification_access"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_change_pin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/change_pin"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_exit_kiosk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/exit_kiosk"
            android:backgroundTint="@color/recording_red" />

    </LinearLayout>
</ScrollView>
